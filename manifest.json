{
   "action": {
      "default_popup": "ui/popup/popup.html",
      "default_title": "Lines Checker"
   },
   "background": {
      "service_worker": "background/background.js"
   },
   "content_scripts": [ {
      "js": [ "content/overlay.js" ],
      "matches": [ "*://*/ads.txt*", "*://*/app-ads.txt*", "*://*/*/ads.txt*", "*://*/*/app-ads.txt*" ],
      "run_at": "document_idle"
   } ],
   "description": "Validate ads.txt and app-ads.txt files, cross-reference seller IDs with sellers.json, detect errors, and analyze SPO metrics",
   "host_permissions": [ "http://*/*", "https://*/*" ],
   "icons": {
      "128": "assets/icons/icon128.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "adWMG Chrome Extension: ads.txt/sellers.json",
   "permissions": [ "tabs", "storage", "scripting", "unlimitedStorage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "7.4.2"
}
